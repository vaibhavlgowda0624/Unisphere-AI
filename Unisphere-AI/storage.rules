rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /notes/{uid}/{noteId} {
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
        && firestore.get(/databases/(default)/documents/notes/$(noteId)).data.uploaderUid == uid;
      allow read: if request.auth != null && request.auth.token.email_verified == true
        && (request.auth.uid == uid
          || firestore.get(/databases/(default)/documents/notes/$(noteId)).data.status == 'APPROVED'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid
        && firestore.get(/databases/(default)/documents/notes/$(noteId)).data.status == 'PENDING';
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
