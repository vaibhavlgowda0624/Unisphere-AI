rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function admin() { return verified() && me().data.role == 'SUPER_ADMIN' && me().data.suspended != true; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'branch', 'year', 'role', 'bio', 'suspended', 'createdAt'])
        && request.resource.data.role == 'STUDENT'
        && request.resource.data.suspended == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.branch is string
        && request.resource.data.year is int
        && request.resource.data.year >= 1 && request.resource.data.year <= 6;
      allow get: if verified() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow update: if verified() && request.auth.uid == uid
        && resource.data.suspended != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'branch', 'year', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.branch is string && request.resource.data.branch.size() > 0
        && request.resource.data.year is int
        && request.resource.data.year >= 1 && request.resource.data.year <= 6;
      allow delete: if false;
    }

    match /role_requests/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'requestedRole', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requestedRole in ['FACULTY', 'CLUB_ADMIN'];
      allow get, list: if verified() && (resource.data.uid == request.auth.uid || admin());
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if verified() && (resource.data.status == 'PUBLISHED' || admin());
      allow write: if false;
    }
    match /event_registrations/{registrationId} {
      allow get, list: if verified() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /clubs/{clubId} {
      allow read: if verified() && (resource.data.status == 'PUBLISHED' || admin());
      allow write: if false;
    }

    match /notes/{noteId} {
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['title', 'description', 'subject', 'branch', 'year', 'tags', 'uploaderUid', 'filePath', 'fileType', 'status', 'createdAt', 'downloadCount'])
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.filePath == 'notes/' + request.auth.uid + '/' + noteId
        && request.resource.data.fileType in ['PDF', 'DOCX']
        && request.resource.data.status == 'PENDING'
        && request.resource.data.downloadCount == 0
        && request.resource.data.title is string
        && request.resource.data.subject is string
        && request.resource.data.tags is list;
      allow read: if verified() && (resource.data.status == 'APPROVED'
        || resource.data.uploaderUid == request.auth.uid || admin());
      allow delete: if verified() && resource.data.uploaderUid == request.auth.uid
        && resource.data.status == 'PENDING';
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
